---
interface Project {
  title: string;
  subtitle: string;
  description: string;
  image?: string;
  gradient?: string;
  link: string;
  preview: string;
  status: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: "Speech Emotion Recognition (SER)",
    subtitle: "Solo Developer • Deep Learning",
    description: "Built a deep learning system that recognizes emotions from speech, such as anger, happiness, and sadness. Trained on the RAVDESS dataset using a CNN-BiLSTM with Attention model, reaching 76.5% accuracy across 8 emotion classes.",
    image: "/speech_emotion_recognition_feature.jpg",
    link: "http://speech-emotion-recognition-ser.streamlit.app/",
    preview: "http://speech-emotion-recognition-ser.streamlit.app/",
    status: "76.5% Val Accuracy • Live App",
    tags: ["Python", "TensorFlow", "Keras", "Librosa", "NumPy", "Matplotlib", "Streamlit"],
  },
  {
    title: "Fifa Auction",
    subtitle: "Backend Developer • Real-Time Systems",
    description: "A real-time multiplayer auction platform where users join live bidding rooms and see every bid instantly. Built with Flask-SocketIO, with Redis handling live bids and timers and PostgreSQL storing permanent data.",
    image: "/fifa_auction_feature.jpg",
    gradient: "from-blue-600/30 via-indigo-600/20 to-purple-600/30",
    link: "https://github.com/Chandhru2k5/Fifa26-Auction",
    preview: "#projects",
    status: "Redis + PostgreSQL • Real-Time",
    tags: ["Flask", "Flask-SocketIO", "PostgreSQL", "Redis", "Python", "REST APIs"],
  },
  {
    title: "SocieTie",
    subtitle: "Backend Developer • Volunteer Platform",
    description: "A full-stack web platform that connects volunteers with nearby orphanages. Volunteers can discover orphanages by location, and an AI assistant answers questions from uploaded PDF documents. Built with Flask and MongoDB.",
    image: "/societie_preview.jpg",
    link: "https://github.com/Chandhru2k5/SocieTie",
    preview: "#projects",
    status: "MongoDB GeoJSON • RAG AI",
    tags: ["Flask", "MongoDB", "GeoJSON 2dsphere", "FAISS", "LangChain", "JavaScript"],
  },
];

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section
  id="projects"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">A Few Things I’ve Built</h2>
        <h3 class="text-4xl md:text-5xl font-medium">Featured Projects</h3>
      </div>
      <p class="text-sm text-[var(--white-icon)] max-w-md">
        From real-time systems to applied AI and community tools, these projects reflect what I enjoy building.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <div class="group flex flex-col h-full bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl overflow-hidden hover:border-[var(--sec)] transition-all duration-300">
            <div class={`relative overflow-hidden h-48 border-b border-[var(--white-icon-tr)] flex items-center justify-center ${project.gradient ? `bg-gradient-to-br ${project.gradient}` : 'bg-slate-900'}`}>
              {project.image ? (
                <img
                  src={
                    project.image.startsWith("/")
                      ? `${baseUrl}${project.image.slice(1)}`
                      : project.image
                  }
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="flex flex-col items-center justify-center p-6 text-center">
                  <div class="size-12 rounded-xl bg-purple-500/20 border border-purple-500/30 flex items-center justify-center text-[var(--sec)] mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                      <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM11 7H13V9H11V7ZM11 11H13V17H11V11Z"/>
                    </svg>
                  </div>
                  <span class="text-sm font-semibold text-white tracking-wide">Multiplayer Auction Engine</span>
                  <span class="text-xs text-slate-400 mt-1">SocketIO & Redis Architecture</span>
                </div>
              )}
              <div class="absolute top-3 right-3 bg-[#101010cc] border border-[var(--white-icon-tr)] backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-semibold text-[var(--sec)]">
                {project.status}
              </div>
            </div>

            <div class="p-5 flex flex-col flex-grow">
              <span class="text-xs uppercase tracking-wider text-[var(--sec)] font-semibold mb-1">
                {project.subtitle}
              </span>
              <h4 class="text-xl font-bold mb-2 text-white group-hover:text-[var(--sec)] transition-colors">
                {project.title}
              </h4>
              <p class="text-xs text-[var(--white-icon)] leading-relaxed mb-4 flex-grow">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs rounded-md bg-white/5 border border-white/10 text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="pt-3 border-t border-[var(--white-icon-tr)] flex items-center justify-between mt-auto">
                {project.preview !== "#projects" ? (
                  <a
                    href={project.preview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--sec)] hover:underline"
                  >
                    Live Demo
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-3.5"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--white-icon)]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Local deployment
                  </span>
                )}
                
                <a
                  target="_blank"
                  href={project.link}
                  aria-label="Repository"
                  class="size-8 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-200 border border-[var(--white-icon-tr)] rounded-lg bg-black/40 hover:bg-[var(--white-icon-tr)]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-4"
                  >
                    <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
