---
interface Props {
  title: string;
}

import "@fontsource-variable/montserrat/wght.css";

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Chandhru R - Competitive Programmer and Aspiring Software Development Engineer specializing in AI, Deep Learning, and Scalable Backend Systems."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />

    <meta
      property="og:title"
      content="Chandhru R | Software Engineer & AI Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Chandhru R - Software Development Engineer with expertise in Data Structures, Algorithms, AI, and Full-Stack Engineering."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Chandhru R Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Chandhru R",
        "jobTitle": "Software Development Engineer",
        "description": "Competitive programmer and aspiring Software Development Engineer with strong foundations in Data Structures, Algorithms, OS, Networks, DBMS, and Deep Learning."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
